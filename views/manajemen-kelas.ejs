<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <title>Manajemen Kelas</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="dashboard-wrapper">
        <%- include('partials/sidebar-operator') %>

            <main class="content-area">
                <header class="content-header">
                    <h1>Manajemen Kelas</h1>
                </header>
                <button class="btn-add" onclick="openModal('modalTambahKelas')">+ Tambah Kelas</button>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nama Kelas</th>
                                <th>Wali Kelas</th>
                                <th>Jumlah Murid</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% data_kelas.forEach(k=> { %>
                                <tr>
                                    <td>
                                        <%= k.id_kelas %>
                                    </td>
                                    <td><strong>
                                            <%= k.nama_kelas %>
                                        </strong></td>
                                    <td>
                                        <%= k.wali_kelas || '—' %>
                                    </td>
                                    <td>
                                        <%= k.jumlah_murid %> Siswa
                                    </td>
                                    <td>
                                        <button class="btn-edit" onclick="editKelas('<%= k.id_kelas %>')">Edit</button>
                                        <button class="btn-hapus"
                                            onclick="hapusKelas('<%= k.id_kelas %>')">Hapus</button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>

            </main>
    </div>

    <div id="modalTambahKelas" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal('modalTambahKelas')">&times;</span>
            <h2>Tambah Kelas Baru</h2>
            <form action="/api/tambah-kelas" method="POST">
                <div class="form-group">
                    <label>Nama Kelas</label>
                    <input type="text" name="nama_kelas" placeholder="Contoh: X PPLG 1" required>
                </div>
                <div class="form-group">
                    <label>Pilih Wali Kelas</label>
                    <select name="id_wali">
                        <option value="">-- Tanpa Wali Kelas --</option>
                        <% data_guru.forEach(g=> { %>
                            <option value="<%= g.id_guru %>">
                                <%= g.nama_lengkap %>
                            </option>
                            <% }) %>
                    </select>
                </div>
                <button type="submit" class="btn-save">Simpan Kelas</button>
            </form>
        </div>
    </div>

    <div id="modalEditKelas" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal('modalEditKelas')">&times;</span>
            <h2>Edit Kelas</h2>
            <form action="/api/update-kelas" method="POST">
                <input type="hidden" name="id_kelas" id="edit-id-kelas">
                <div class="form-group">
                    <label>Nama Kelas</label>
                    <input type="text" name="nama_kelas" id="edit-nama-kelas" required>
                </div>
                <div class="form-group">
                    <label>Pilih Wali Kelas</label>
                    <select name="id_wali" id="edit-wali-kelas">
                        <option value="">-- Tanpa Wali Kelas --</option>
                        <% data_guru.forEach(g=> { %>
                            <option value="<%= g.id_guru %>">
                                <%= g.nama_lengkap %>
                            </option>
                            <% }) %>
                    </select>
                </div>
                <button type="submit" class="btn-save">Update Kelas</button>
            </form>
        </div>
    </div>

    <script>
        function openModal(id) { document.getElementById(id).style.display = 'flex'; }
        function closeModal(id) { document.getElementById(id).style.display = 'none'; }

        function editKelas(id) {
            fetch('/api/get-kelas/' + id)
                .then(res => res.json())
                .then(data => {
                    document.getElementById('edit-id-kelas').value = data.id_kelas;
                    document.getElementById('edit-nama-kelas').value = data.nama_kelas;
                    document.getElementById('edit-wali-kelas').value = data.id_wali_guru || "";
                    openModal('modalEditKelas');
                });
        }

        function hapusKelas(id) {
            if (confirm('Hapus kelas ini? Data murid di dalamnya mungkin akan kehilangan referensi kelas.')) {
                window.location.href = '/api/hapus-kelas/' + id;
            }
        }
    </script>
</body>

</html>