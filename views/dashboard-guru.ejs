<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Guru - Beranda</title>
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <div class="dashboard-wrapper">
        <%- include('partials/sidebar-guru') %>

            <main class="content-area">
                <header class="content-header" style="background-color: #3f6aa5; padding: 20px 30px; color: white;">
                    <h1 style="margin: 0; font-size: 28px; font-weight: 600;">Beranda</h1>
                </header>

                <div class="dashboard-body" style="padding: 30px; background-color: #ffffff;">

                    <div class="stats-grid"
                        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px;">
                        <div class="stat-card border-red"
                            style="border-left: 5px solid #ff5e5e; background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                            <p class="stat-title"
                                style="margin: 0 0 10px 0; color: #333; font-weight: bold; font-size: 16px;">Tugas
                                Dibuat</p>
                            <h2 class="stat-number" style="margin: 0; font-size: 36px; font-weight: 700; color: #111;">
                                <%= stats.dibuat %>
                            </h2>
                        </div>
                        <div class="stat-card border-purple"
                            style="border-left: 5px solid #5b5be3; background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                            <p class="stat-title"
                                style="margin: 0 0 10px 0; color: #333; font-weight: bold; font-size: 16px;">Belum
                                Selesai</p>
                            <h2 class="stat-number" style="margin: 0; font-size: 36px; font-weight: 700; color: #111;">
                                <%= stats.belum %>
                            </h2>
                        </div>
                        <div class="stat-card border-yellow"
                            style="border-left: 5px solid #f1c40f; background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                            <p class="stat-title"
                                style="margin: 0 0 10px 0; color: #333; font-weight: bold; font-size: 16px;">Tugas
                                Tuntas</p>
                            <h2 class="stat-number" style="margin: 0; font-size: 36px; font-weight: 700; color: #111;">
                                <%= stats.tuntas %>
                            </h2>
                        </div>
                        <div class="stat-card border-green"
                            style="border-left: 5px solid #2ecc71; background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                            <p class="stat-title"
                                style="margin: 0 0 10px 0; color: #333; font-weight: bold; font-size: 16px;">Kelas</p>
                            <h2 class="stat-number" style="margin: 0; font-size: 36px; font-weight: 700; color: #111;">
                                <%= stats.kelas %>
                            </h2>
                        </div>
                    </div>

                    <div class="chart-container"
                        style="background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid #f1f3f5;">
                        <h3 class="chart-title"
                            style="margin-top: 0; margin-bottom: 20px; font-size: 18px; font-weight: 700; color: #111;">
                            Tren Penyelesaian Tugas Mingguan</h3>
                        <canvas id="lineChartGuru" height="100"></canvas>
                    </div>
                </div>
            </main>
    </div>

    <script>
        const ctx = document.getElementById('lineChartGuru').getContext('2d');

        // Membaca data array yang dikirimkan oleh Express Node.js secara aman
        // Mengubah data EJS menjadi string terlebih dahulu, baru di-parse menjadi array JavaScript asli
        const dataSelesaiServer = JSON.parse('[<%= chartData.selesai %>]');
        const dataBelumServer = JSON.parse('[<%= chartData.belum %>]');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
                datasets: [
                    {
                        label: 'Selesai',
                        data: dataSelesaiServer,
                        borderColor: '#3498db',
                        backgroundColor: '#3498db',
                        tension: 0.3,
                        fill: false,
                        pointRadius: 4
                    },
                    {
                        label: 'Belum Selesai',
                        data: dataBelumServer,
                        borderColor: '#e74c3c',
                        backgroundColor: '#e74c3c',
                        tension: 0.3,
                        fill: false,
                        pointRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'top' }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 5 } // Skala kelipatan 5 biar rapi sesuai gambar
                    }
                }
            }
        });
    </script>
</body>

</html>