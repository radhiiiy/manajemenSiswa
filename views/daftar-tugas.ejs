<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Tugas | <%= nama_lengkap %>
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="ds-wrapper">
        <aside class="sidebar-siswa">
            <div class="profile-section">
                <div class="profile-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
                <h3>
                    <%= nama_lengkap %>
                </h3>
            </div>

            <nav class="sidebar-nav">
                <a href="/dashboard-siswa">Beranda</a>
                <a href="/daftar-tugas" class="active">Daftar Tugas</a>
                <a href="/logout" style="margin-top: auto;">Keluar</a>
            </nav>
        </aside>

        <div class="ds-main">
            <header class="content-header">
                <h1>Daftar Tugas</h1>
            </header>

            <div class="dt-container">
                <% if (tugas.length> 0) { %>
                    <% tugas.forEach(item=> { %>
                        <div class="dt-card">
                            <div class="dt-info">
                                <h2 class="dt-subject">
                                    <%= item.mapel %>
                                </h2>
                                <div class="dt-teacher">
                                    <span class="dt-avatar-circle">
                                        <%= item.guru.charAt(0).toUpperCase() %>
                                    </span>
                                    <p>
                                        <%= item.guru %>
                                    </p>
                                </div>
                            </div>
                            <div class="dt-status-box">
                                <div
                                    class="dt-icon-status <%= item.status === 'selesai' ? 'status-done' : 'status-pending' %>">
                                    <% if (item.status==='selesai' ) { %>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                        <% } else { %>
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                            <% } %>
                                </div>
                                <button class="dt-btn-detail">detail tugas</button>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <p style="text-align: center; margin-top: 20px;">Belum ada tugas untuk kelas Anda.</p>
                                <% } %>
            </div>
        </div>
    </div>
    </div>

</body>

</html>