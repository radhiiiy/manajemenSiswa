<!DOCTYPE html>
<html lang="id">
<head>
    <link rel="stylesheet" href="/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <title>Dashboard</title>
</head>
<body>
    <div class="dashboard-wrapper">
        <%- include('partials/sidebar-operator') %>
        <main class="content-area">
            <header class="content-header"><h1>Beranda</h1></header>
            <div class="dashboard-body">
                <div class="stats-grid">
                    <div class="stat-card"><p>Total Guru</p><h2><%= stats.guru %></h2></div>
                    <div class="stat-card"><p>Total Siswa</p><h2><%= stats.siswa %></h2></div>
                    <div class="stat-card"><p>Total Tugas</p><h2><%= stats.tugas %></h2></div>
                    <div class="stat-card"><p>Total Kelas</p><h2><%= stats.kelas %></h2></div>
                </div>
                <div class="chart-container">
                    <div class="operator-charts-grid">
                        <div class="chart-box"><h4>Tugas per Kelas</h4><canvas id="chartKelas"></canvas></div>
                        <div class="chart-box"><h4>Tugas per Guru</h4><canvas id="chartGuru"></canvas></div>
                        <div class="chart-box"><h4>Persentase Selesai</h4><canvas id="chartSelesai"></canvas></div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <script>
        // Inisialisasi Chart.js di sini (seperti kode sebelumnya)
    </script>
</body>
</html>